[gd_scene format=3 uid="uid://c5qi10qtwrsty"]

[sub_resource type="GDScript" id="GDScript_wqrl3"]
script/source = "class_name DesktopMainPC
extends CanvasLayer

signal closed
signal content_enabled

@onready var desktop_panel: Panel = $DesktopPanel
@onready var cloud_file_panel: Panel = $CloudFilePanel
@onready var enable_content_button: Button = $CloudFilePanel/Content/EnableContentButton

var _cloud_file_opened: bool = false

func _ready() -> void:
	$DesktopPanel/Content/GGDiskButton.pressed.connect(_on_gg_disk_pressed)
	$DesktopPanel/Content/TextEditorButton.pressed.connect(_on_text_editor_pressed)
	$DesktopPanel/Content/CloseButton.pressed.connect(_on_close_pressed)
	$CloudFilePanel/Content/CloseButton.pressed.connect(_on_close_cloud_file_pressed)
	enable_content_button.pressed.connect(_on_enable_content_pressed)
	cloud_file_panel.hide()

func _on_gg_disk_pressed() -> void:
	cloud_file_panel.show()
	if _cloud_file_opened:
		return
	_cloud_file_opened = true
	TelemetryManager.track_event(
		\"Scene_02\",
		\"T03\",
		\"cloud_file_opened\",
		0.0,
		true,
		1,
		false,
		{\"file_name\": \"Report_Final.docx\", \"source\": \"GG Disk\"}
	)

func _on_text_editor_pressed() -> void:
	$DesktopPanel/Content/StatusLabel.text = \"Text Editor is ready.\"

func _on_enable_content_pressed() -> void:
	content_enabled.emit()

func _on_close_cloud_file_pressed() -> void:
	cloud_file_panel.hide()

func _on_close_pressed() -> void:
	closed.emit()
"

[node name="Desktop_Main_PC" type="CanvasLayer" unique_id=1341203409]
script = SubResource("GDScript_wqrl3")

