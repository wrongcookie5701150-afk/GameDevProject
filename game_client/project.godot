; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="CyberSecurityGame"
run/main_scene="res://ui/menus/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://csq7tjqxsjycq"

[autoload]

TelemetryManager="*res://autoload/TelemetryManager.gd"
MCPRuntimeServer="*res://addons/godot_mcp_toolkit/runtime/mcp_runtime_server.gd"
GlobalSettings="*res://autoload/GlobalSettings.gd"
InventoryManager="*res://autoload/InventoryManager.gd"
FloatMenu="*res://ui/menus/FloatMenu.tscn"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/initial_position_type=4
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"
window/vsync/vsync_mode=2

[dotnet]

project/assembly_name="CyberSecurityGame"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp_toolkit/plugin.cfg")

[gui]

theme/custom_font="uid://gnl606br2xmt"

